<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fundo da janela na cor do tema padrão: a primeira imagem nunca é uma tela preta (RF-16). -->
    <style name="Theme.TemaTv" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/default_theme_background</item>
        <item name="android:textColor">@color/default_theme_text</item>
    </style>

    <style name="DiagnosticsLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DiagnosticsValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
