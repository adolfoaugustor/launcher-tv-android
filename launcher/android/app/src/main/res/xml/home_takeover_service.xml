<?xml version="1.0" encoding="utf-8"?>
<!-- Só recebe a troca de janela dos launchers do sistema (D-01, D-02); não lê o conteúdo das telas. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/takeover_service_description"
    android:notificationTimeout="100"
    android:packageNames="com.google.android.apps.tv.launcherx,com.google.android.tvlauncher,com.google.android.leanbacklauncher" />
