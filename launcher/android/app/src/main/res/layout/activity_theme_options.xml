<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="32dp"
        android:paddingEnd="64dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/theme_options_title"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            style="@style/DiagnosticsLabel"
            android:text="@string/diagnostics_takeover" />

        <TextView
            android:id="@+id/takeoverValue"
            style="@style/DiagnosticsValue" />

        <Button
            android:id="@+id/takeoverToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAllCaps="false" />

        <ProgressBar
            android:id="@+id/holdProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="320dp"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/holdHintText"
            style="@style/DiagnosticsValue"
            android:text="@string/takeover_hold_hint"
            android:visibility="gone" />

        <TextView
            style="@style/DiagnosticsLabel"
            android:text="@string/diagnostics_accessibility" />

        <TextView
            android:id="@+id/accessibilityValue"
            style="@style/DiagnosticsValue" />

        <TextView
            android:id="@+id/accessibilityStepsText"
            style="@style/DiagnosticsValue"
            android:text="@string/takeover_service_steps"
            android:visibility="gone" />

        <Button
            android:id="@+id/openAccessibilitySettingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/takeover_open_accessibility_settings"
            android:textAllCaps="false"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/diagnostics_title"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            style="@style/DiagnosticsLabel"
            android:text="@string/diagnostics_app_version" />

        <TextView
            android:id="@+id/appVersionValue"
            style="@style/DiagnosticsValue" />

        <TextView
            style="@style/DiagnosticsLabel"
            android:text="@string/diagnostics_active_theme" />

        <TextView
            android:id="@+id/activeThemeValue"
            style="@style/DiagnosticsValue" />

        <TextView
            style="@style/DiagnosticsLabel"
            android:text="@string/diagnostics_theme_origin" />

        <TextView
            android:id="@+id/themeOriginValue"
            style="@style/DiagnosticsValue" />

        <TextView
            style="@style/DiagnosticsLabel"
            android:text="@string/diagnostics_last_error" />

        <TextView
            android:id="@+id/lastErrorValue"
            style="@style/DiagnosticsValue" />

        <TextView
            style="@style/DiagnosticsLabel"
            android:text="@string/diagnostics_last_takeover" />

        <TextView
            android:id="@+id/lastTakeoverValue"
            style="@style/DiagnosticsValue" />

        <TextView
            style="@style/DiagnosticsLabel"
            android:text="@string/diagnostics_last_service_off" />

        <TextView
            android:id="@+id/lastServiceOffValue"
            style="@style/DiagnosticsValue" />

        <TextView
            style="@style/DiagnosticsLabel"
            android:text="@string/diagnostics_last_loop_pause" />

        <TextView
            android:id="@+id/lastLoopPauseValue"
            style="@style/DiagnosticsValue" />

        <TextView
            style="@style/DiagnosticsLabel"
            android:text="@string/diagnostics_license" />

        <TextView
            android:id="@+id/licenseValue"
            style="@style/DiagnosticsValue" />
    </LinearLayout>
</ScrollView>
